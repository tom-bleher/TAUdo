<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld courses are tracked.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@v@</string>
		<key>v</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>קורס אחד במעקב.</string>
			<key>other</key>
			<string>%1$lld קורסים במעקב.</string>
		</dict>
	</dict>
	<key>%lld new deadlines on Moodle</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@v@</string>
		<key>v</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>מועד הגשה חדש ב־Moodle</string>
			<key>other</key>
			<string>%1$lld מועדי הגשה חדשים ב־Moodle</string>
		</dict>
	</dict>
	<key>Saved %lld files from %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@v@</string>
		<key>v</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>נשמר קובץ אחד מהקורס %2$@</string>
			<key>other</key>
			<string>נשמרו %1$lld קבצים מהקורס %2$@</string>
		</dict>
	</dict>
</dict>
</plist>
