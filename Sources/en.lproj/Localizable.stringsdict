<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
	<key>%lld courses are tracked.</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@v@</string>
		<key>v</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>1 course is tracked.</string>
			<key>other</key>
			<string>%1$lld courses are tracked.</string>
		</dict>
	</dict>
	<key>%lld new deadlines on Moodle</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@v@</string>
		<key>v</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>1 new deadline on Moodle</string>
			<key>other</key>
			<string>%1$lld new deadlines on Moodle</string>
		</dict>
	</dict>
	<key>Saved %lld files from %@</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@v@</string>
		<key>v</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>Saved 1 file from %2$@</string>
			<key>other</key>
			<string>Saved %1$lld files from %2$@</string>
		</dict>
	</dict>
	<key>%lld hidden courses</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@v@</string>
		<key>v</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>1 hidden course</string>
			<key>other</key>
			<string>%1$lld hidden courses</string>
		</dict>
	</dict>
	<key>%lld hidden deadlines</key>
	<dict>
		<key>NSStringLocalizedFormatKey</key>
		<string>%1$#@v@</string>
		<key>v</key>
		<dict>
			<key>NSStringFormatSpecTypeKey</key>
			<string>NSStringPluralRuleType</string>
			<key>NSStringFormatValueTypeKey</key>
			<string>lld</string>
			<key>one</key>
			<string>1 hidden deadline</string>
			<key>other</key>
			<string>%1$lld hidden deadlines</string>
		</dict>
	</dict>
</dict>
</plist>
